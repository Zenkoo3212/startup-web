Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:includes|configuracion|base_de_datos|documentacion|\.git)(?:/|$) - [F,L]
</IfModule>

<FilesMatch "(^\.|^Dockerfile$|\.(sql|md|json|lock|ya?ml|log|ini|bak|zip)$|^(config(?:\..*)?|helpers|correo|test_db)\.php$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
